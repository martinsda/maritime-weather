{
	"name": "maritime-briefing-email",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"workers_dev": false,
	"triggers": {
		// Sundays only, 07:00 UTC — independent of the GitHub Action, since this
		// Worker fetches and builds the briefing itself.
		"crons": ["0 7 * * SUN"]
	},
	"vars": {
		"EMAIL_FROM": "maritime-briefing@danielmartins.org",
		"EMAIL_TO": "email.to.x@gmail.com,calad0@icloud.com"
	}
}
